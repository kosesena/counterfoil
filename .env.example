# Braintree sandbox (Settings → API in the sandbox control panel)
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Optional: PayPal REST sandbox (developer.paypal.com → Apps & Credentials, Sandbox). run_eval.py --rail paypal;
# the demo uses it when DEMO_RAIL=paypal. Without both values no PayPal REST call is made.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# DEMO_RAIL=paypal

# Optional: cloud models for the comparison (scripts/run_eval.py --model ...)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ASTRA_MODEL_ID=
